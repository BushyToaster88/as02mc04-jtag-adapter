	(text "SERIES RESISTORS\n(the HS3 already has 100R inside)"
		(exclude_from_sim no)
		(at 99.06 53.34 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "183d7c72-3478-5f49-811d-77e47c470867")
	)
	(text "1.8 V FEED: R9 limits what a fault behind it can draw\nfrom the card's 1.8 V rail to 0.38 A. It is a 0.75 W part: a dead short\nmakes it hot, not burnt. Only J2 pin 1, the 2 mm link and R9 pad 1 are ahead of it."
		(exclude_from_sim no)
		(at 33.02 132.08 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "247e5b0c-b6e6-502f-bcf6-506b4b16cc3f")
	)
	(text "CARD SIDE: J2 plugs straight onto card header J4,\nor takes a 6-way male-to-female jumper cable.\nJ2 pin n meets J4 pin n."
		(exclude_from_sim no)
		(at 149.86 50.8 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "43cd18e7-0c82-5c96-a49d-6bef758c6345")
	)
	(text "TEST HOLES (not fitted)\nfor a scope or logic analyzer"
		(exclude_from_sim no)
		(at 200.66 53.34 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "5349aeaa-d4e1-5af3-9acf-93a822a873dc")
	)
	(text "Card header J4 (AS02MC04, XCKU3P bank 0, 1.8 V ONLY)\npin 1  1V8  reference voltage from the card\npin 2  TMS\npin 3  TCK  (silkscreen on the card says TDK)\npin 4  TDO\npin 5  TDI\npin 6  GND"
		(exclude_from_sim no)
		(at 200.66 114.3 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "5acd965b-d49e-5c6b-bed8-35dba354996b")
	)
	(text "HS3 SIDE: Xilinx 14-pin JTAG header.\nPin 2 is the HS3 buffer supply (VREF)."
		(exclude_from_sim no)
		(at 38.1 53.34 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "a3f72de7-1011-5aa6-8273-c77154494283")
	)
	(text "REVERSED INDICATOR: sits across the two end pins (behind R9),\nso it glows only when 1.8 V arrives the wrong way round.\nDim by nature (1.8 V). No light does NOT prove correct orientation."
		(exclude_from_sim no)
		(at 185.42 132.08 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "ba4d8cd1-f85d-54e4-a8f2-da20c93884a6")
	)
	(text "REVERSE-INSERTION PROTECTION: Q1 sits in the ground lead.\nCorrect way round: gate sees 1.8 V, Q1 is on.\nReversed: gate sees 0 V, body diode blocks, no short."
		(exclude_from_sim no)
		(at 111.76 132.08 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "fee7cdfe-0072-5e17-b7dd-04dd1d87b99d")
	)
